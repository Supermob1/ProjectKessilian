# ================================================================
# Folder-specific tech-item backgrounds. HoI4 builds the box sprite name from
# the folder name: GFX_technology_<folder>_<state>_item_bg. Without these the
# swnaval folders fell back to the generic 183x84 box (narrow/tall/wrong colour).
# Point them at vanilla's WIDE naval box art (tech_naval_*, 332x69) so the hull
# boxes render wide+thin exactly like the vanilla naval tree; module/small items
# use the 72x72 doctrine box (this also shrinks the oversized module boxes).
# ================================================================
	spriteType = { name = "GFX_technology_swnaval_folder_available_item_bg"                 texturefile = "gfx/interface/techtree/tech_naval_available_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_folder_unavailable_item_bg"               texturefile = "gfx/interface/techtree/tech_naval_unavailable_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_folder_researched_item_bg"                texturefile = "gfx/interface/techtree/tech_naval_researched_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_folder_currently_researching_item_bg"     texturefile = "gfx/interface/techtree/tech_naval_researched_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_folder_small_available_item_bg"           texturefile = "gfx/interface/techtree/tech_doctrine_available_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_folder_small_unavailable_item_bg"         texturefile = "gfx/interface/techtree/tech_doctrine_unavailable_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_folder_small_researched_item_bg"          texturefile = "gfx/interface/techtree/tech_landdoctrine_researched_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_folder_small_currently_researching_item_bg" texturefile = "gfx/interface/techtree/tech_landdoctrine_researched_item_bg.dds" }

	spriteType = { name = "GFX_technology_swnaval_support_folder_available_item_bg"                 texturefile = "gfx/interface/techtree/tech_naval_available_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_support_folder_unavailable_item_bg"               texturefile = "gfx/interface/techtree/tech_naval_unavailable_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_support_folder_researched_item_bg"                texturefile = "gfx/interface/techtree/tech_naval_researched_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_support_folder_currently_researching_item_bg"     texturefile = "gfx/interface/techtree/tech_naval_researched_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_support_folder_small_available_item_bg"           texturefile = "gfx/interface/techtree/tech_doctrine_available_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_support_folder_small_unavailable_item_bg"         texturefile = "gfx/interface/techtree/tech_doctrine_unavailable_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_support_folder_small_researched_item_bg"          texturefile = "gfx/interface/techtree/tech_landdoctrine_researched_item_bg.dds" }
	spriteType = { name = "GFX_technology_swnaval_support_folder_small_currently_researching_item_bg" texturefile = "gfx/interface/techtree/tech_landdoctrine_researched_item_bg.dds" }

