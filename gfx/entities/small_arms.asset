### 		REPUBLIC DEFAULT Weapons 		  ###
#################################################

#DC15
entity = {
	name = "REP_infantry_weapon_DC15_entity"
	pdxmesh = "infantry_weapon_DC15_mesh"
	
	get_state_from_parent = yes
	default_state = "idle"
	state = { name = "idle" }
	state = { name = "move"	}

	state = {
	name = "attack"	animation = "attack"
	event = { time = 1.15 node="muzzle2" particle = "hosw_muzzleblue_mg"  keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = infantry_blaster_attack } }
	event = { time = 1.15 node="muzzle2" particle = "hosw_blue_blastershot_mg"  keep_particle = yes }
	}

	state = {
	name = "defend"
	event = { time = 0 node="muzzle2" particle = "hosw_muzzleblue_mg"  keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = infantry_blaster_attack } }
	event = { time = 0 node="muzzle2" particle = "hosw_blue_blastershot_mg"  keep_particle = yes }
	}

	state = {
	name = "support_attack"	animation = "support_attack"
	event = { time = 0 node="muzzle2" particle = "hosw_muzzleblue_mg"  keep_particle = yes light = "mg_muzzle_flash" sound = { soundeffect = infantry_blaster_attack } }
	event = { time = 0 node="muzzle2" particle = "hosw_blue_blastershot_mg"  keep_particle = yes }
	}
}
