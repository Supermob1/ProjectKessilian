# Empire aircraft entity definitions.
#
# Per the modding guide: "For aircraft you can use equipment names".
# The mod's aircraft subunits (common/units/empire aircraft.txt) are:
#   tie_fighter, tie_heavy_fighter, tie_interceptor, tie_bomber, space_transport
# And their associated equipment archetypes (in zz_imperial_aircraft etc.):
#   imp_fighter_equipment, imp_defender_equipment, imp_interceptor_equipment,
#   imp_bomber_equipment, imperial_transport_plane_equipment
#
# Defining entries for BOTH subunit-name and equipment-name lookups so
# the engine finds a match regardless of which path it queries.

entity = {
	name = "IMP_plane_base_entity"
	pdxmesh = "tie_mesh"

	state = { name = "fire" animation = "idle"
		event = { time = 0 node = "gun1" particle = "plane_mg_muzzle_particle" keep_particle = yes sound = { soundeffect = "airplane_ger_jet_fire" } }
		event = { time = 0.3 node = "gun2" particle = "plane_mg_muzzle_particle" keep_particle = yes }
	}
	state = { name = "bomb" animation = "idle"
		event = { time = 0 node = "bomb" particle = "bomb_particle" keep_particle = yes sound = { soundeffect = "airplane_bomb" } }
	}
	state = { name = "idle" animation = "idle" }
	state = { name = "crash" animation = "idle"
		event = { time = 0 node = "engine1" particle = "explosion_particle" keep_particle = yes sound = { soundeffect = "airplane_crash" } }
		event = { time = 0 node = "engine2" particle = "explosion_particle" keep_particle = yes sound = { soundeffect = "airplane_crash" } }
	}
	state = { name = "explode" animation = "idle"
		event = { time = 0 particle = "vehicle_explode_effect" keep_particle = yes }
	}
	scale = 0.19
}

# Per-subunit entities (match each empire-aircraft sub_unit name)
entity = { clone = "IMP_plane_base_entity"  name = "IMP_tie_fighter_entity" }
entity = { clone = "IMP_plane_base_entity"  name = "IMP_tie_heavy_fighter_entity" }
entity = { clone = "IMP_plane_base_entity"  name = "IMP_tie_interceptor_entity" }
entity = { clone = "IMP_plane_base_entity"  name = "IMP_tie_bomber_entity" }
entity = { clone = "IMP_plane_base_entity"  name = "IMP_space_transport_entity" }

# Per-equipment-name entities (per modding guide, aircraft can use eq names)
entity = { clone = "IMP_plane_base_entity"  name = "IMP_imp_fighter_equipment_entity" }
entity = { clone = "IMP_plane_base_entity"  name = "IMP_imp_defender_equipment_entity" }
entity = { clone = "IMP_plane_base_entity"  name = "IMP_imp_interceptor_equipment_entity" }
entity = { clone = "IMP_plane_base_entity"  name = "IMP_imp_bomber_equipment_entity" }
entity = { clone = "IMP_plane_base_entity"  name = "IMP_imperial_transport_plane_equipment_entity" }
# SWX-036: the gunship archetype (added v0.5, SWX-003) was never registered here -
# the missing entity lookup crashed the game the moment a gunship wing was created.
entity = { clone = "IMP_plane_base_entity"  name = "IMP_imp_gunship_equipment_entity" }

# Sprite-name fallbacks (in case engine queries by sprite type)
entity = { clone = "IMP_plane_base_entity"  name = "IMP_light_plane_entity" }
entity = { clone = "IMP_plane_base_entity"  name = "IMP_jet_plane_entity" }
entity = { clone = "IMP_plane_base_entity"  name = "IMP_medium_plane_entity" }
entity = { clone = "IMP_plane_base_entity"  name = "IMP_heavy_plane_entity" }
