# Empire armor/vehicle entity definitions.
#
# Naming convention per the HoI4 modding guide:
#   <Identifier>_<subunit_name>_<visual_level>_entity_<variant>
# Identifier = IMP (country tag). Subunit names come from
# common/units/imperial_land_vehicles.txt sub_units block.
#
# Base entity defines the full state machine + mesh; per-subunit
# entries clone it. This way every Imperial vehicle subunit gets the
# IMP_tank model when deployed.

entity = {
	name = "IMP_armor_base_entity"
	pdxmesh = "IMP_armor_mesh"

	state = { name = "idle"				animation = "idle"   animation_blend_time = 0.3 }
	state = { name = "move"				animation = "move"   animation_blend_time = 0.3
		event = { time = 0 node="right_exhaust" particle = "tank_exhaust_particle"  keep_particle = no trigger_once = yes }
		event = { time = 0 node="left_exhaust"  particle = "tank_exhaust_particle"  keep_particle = no trigger_once = yes }
		event = { time = 0 node="left_tracks"   particle = "tank_moving_tracks_particle" keep_particle = no trigger_once = yes }
		event = { time = 0 node="right_tracks"  particle = "tank_moving_tracks_particle" keep_particle = no trigger_once = yes }
		event = { trigger_once = yes sound = { soundeffect = "tank_engine_light_move" } }
	}
	state = { name = "retreat"			animation = "move"   animation_blend_time = 0.3 }
	state = { name = "attack"			animation = "attack" animation_blend_time = 0.3
		event = { time = 0 node="barrel" particle = "light_tank_attack_barrel_particle" keep_particle = yes sound = { soundeffect = light_armour_fire } }
	}
	state = { name = "defend"			animation = "attack" animation_blend_time = 0.3 }
	state = { name = "support_attack"	animation = "attack" animation_blend_time = 0.3 }
	state = { name = "training"			animation = "idle"   animation_blend_time = 0.3 }

	scale = 0.55

	game_data = {
		texture_anim_speed = 0.5
	}
}

# Per-subunit entities (match each imperial_land_vehicles.txt sub_unit name)
entity = { clone = "IMP_armor_base_entity"  name = "IMP_speeder_entity" }
entity = { clone = "IMP_armor_base_entity"  name = "IMP_light_vehicle_entity" }
entity = { clone = "IMP_armor_base_entity"  name = "IMP_assault_vehicle_entity" }
entity = { clone = "IMP_armor_base_entity"  name = "IMP_heavy_vehicle_entity" }
entity = { clone = "IMP_armor_base_entity"  name = "IMP_super_heavy_vehicle_entity" }
entity = { clone = "IMP_armor_base_entity"  name = "IMP_armored_troop_transport_entity" }
entity = { clone = "IMP_armor_base_entity"  name = "IMP_heavy_armored_troop_transport_entity" }
entity = { clone = "IMP_armor_base_entity"  name = "IMP_mobile_artillery_entity" }
entity = { clone = "IMP_armor_base_entity"  name = "IMP_mobile_anti_tank_entity" }
entity = { clone = "IMP_armor_base_entity"  name = "IMP_mobile_anti_air_entity" }

# Sprite-name fallbacks (in case engine queries by sprite type)
entity = { clone = "IMP_armor_base_entity"  name = "IMP_medium_armor_entity" }
entity = { clone = "IMP_armor_base_entity"  name = "IMP_light_armor_entity" }
entity = { clone = "IMP_armor_base_entity"  name = "IMP_heavy_armor_entity" }
