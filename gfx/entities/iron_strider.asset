# Iron strider: two-legged walker with a tank hull and turret, set up like the vanilla medium tanks.
# Attack: the main gun fires at 0, the bow MG and the commander MG open up at the same moment with a 6-shot burst.
# Camo: the game picks iron_strider_diffuse_desert.dds / _snow.dds by itself, like vanilla tanks.
entity = {
